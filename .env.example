# Copy to .env and provide the relevant credentials locally.
# Use openrouter by default. Switch LLM_PROVIDER=openai and set OPENAI_API_KEY
# to use the official OpenAI endpoint for a deployment that has a paid key.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=openrouter/free
LLM_TIMEOUT_SECONDS=25

# Optional Neatlogs export and trace readback settings.
NEATLOGS_API_KEY=
NEATLOGS_PROJECT_ID=
NEATLOGS_TOKEN=

# cfo.ai remains the intended finance model; runtime MCP is not yet connected.
CFO_SCENARIO_PATH=
# Optional cfo.ai MCP session setup is account/OAuth based; see README and the
# cfo.ai MCP docs rather than placing browser tokens in this file.
